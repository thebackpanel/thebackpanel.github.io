<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180">
  <style>
    .bg { fill: #FF4D00; }
    .dot { fill: #fff; }
    .text { fill: #fff; font-family: Arial Black, Impact, sans-serif; font-weight: 900; letter-spacing: 1px; }
  </style>
  <rect class="bg" width="180" height="180" rx="40"/>
  <circle class="dot" cx="62" cy="48" r="12"/>
  <circle class="dot" cx="118" cy="48" r="12"/>
  <text class="text" x="90" y="110" text-anchor="middle" font-size="42">BACK</text>
  <text class="text" x="90" y="155" text-anchor="middle" font-size="42">PANEL</text>
</svg>
