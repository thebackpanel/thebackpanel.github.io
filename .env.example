# .env.example — BACKPANEL site configuration
# Copy to .env (never commit .env) for whoever injects snippets / endpoints.
# NOTE: this is a static site. bp-enhance.js reads NONE of these at runtime —
# they are build/deploy-time inputs for whoever pastes the analytics snippet
# or wires the optional Formspree endpoint into the HTML.

# Canonical public URL of the live site. Plugs into: <link rel="canonical">,
# og:url / twitter:url meta tags, JSON-LD "url", sitemap.xml <loc> entries.
SITE_URL=https://thebackpanel.github.io/

# Analytics provider selector. Plugs into: which snippet (if any) gets pasted
# into <head> before bp-enhance.js. Values: none | umami | plausible.
# bp-enhance.js auto-forwards window.bpTrack() events to whichever is present.
ANALYTICS_PROVIDER=none # none|umami|plausible

# Umami snippet inputs. Plugs into: <script src="UMAMI_SRC"
# data-website-id="UMAMI_WEBSITE_ID"> in <head>. Leave blank when unused.
UMAMI_SRC=
UMAMI_WEBSITE_ID=

# Plausible snippet input. Plugs into: <script data-domain="PLAUSIBLE_DOMAIN"
# src="https://plausible.io/js/script.js"> in <head>. Leave blank when unused.
PLAUSIBLE_DOMAIN=

# Optional Formspree endpoint (https://formspree.io/f/XXXX). Plugs into: a
# future fetch() in app.js alongside the Google Forms push. When empty, forms
# fall back to the current behavior in app.js: Google Forms (GF_CONFIG)
# best-effort POST + mailto:founders@backpanel.in fallback.
FORMSPREE_ENDPOINT=
